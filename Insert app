create table refeicao (
    id_refeicao     int auto_increment primary key,
    id_usuario      int not null,
    refeicao        varchar(20),
    data_hora       datetime,
    constraint fk_refeicao_usuario
        foreign key (id_usuario) references usuario (id_usuario)
        on update cascade
        on delete cascade
